{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoforge.local/schemas/converter-pack-index-v1.json",
  "title": "AutoForge signed converter pack index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "sequence", "packs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sequence": { "type": "integer", "minimum": 0 },
    "packs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "platform", "arch", "archiveUrl", "archiveSha256", "archiveBytes", "entries"],
        "properties": {
          "name": { "enum": ["image-icon", "document", "pdf", "media"] },
          "version": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          },
          "platform": { "enum": ["darwin", "win32"] },
          "arch": { "enum": ["arm64", "x64"] },
          "archiveUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "archiveSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "archiveBytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "bytes", "executable"],
              "properties": {
                "path": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "bytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
                "executable": { "type": "boolean" }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "platform": { "const": "win32" } }, "required": ["platform"] },
            "then": { "properties": { "arch": { "const": "x64" } } }
          }
        ]
      }
    }
  }
}
