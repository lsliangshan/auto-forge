generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  displayName    String
  passwordHash   String
  role           UserRole     @default(USER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  refreshTokens  RefreshToken[]
  workflows      Workflow[]
  submissions    Submission[] @relation("SubmissionAuthor")
  reviewed       Submission[] @relation("SubmissionReviewer")
  auditLogs      AuditLog[]
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, familyId])
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  sortOrder   Int        @default(0)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workflows   Workflow[]
  submissions Submission[]
}

model Workflow {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String
  authorId    String
  categoryId  String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  author      User         @relation(fields: [authorId], references: [id])
  category    Category     @relation(fields: [categoryId], references: [id])
  submissions Submission[]
  releases    Release[]
}

model Submission {
  id              String           @id @default(cuid())
  workflowId      String
  authorId        String
  categoryId      String
  version         String
  revision        Int
  status          SubmissionStatus @default(PENDING)
  manifest        Json
  sourceObjectKey String
  sourceSha256    String
  clientCodeSha256 String?
  serverCodeSha256 String
  reviewComment   String?
  reviewerId      String?
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workflow        Workflow         @relation(fields: [workflowId], references: [id])
  author          User             @relation("SubmissionAuthor", fields: [authorId], references: [id])
  reviewer        User?            @relation("SubmissionReviewer", fields: [reviewerId], references: [id])
  category        Category         @relation(fields: [categoryId], references: [id])
  release         Release?
  @@unique([workflowId, version, revision])
  @@index([status, createdAt])
}

model Release {
  id               String     @id @default(cuid())
  workflowId       String
  submissionId     String     @unique
  version          String
  manifest         Json
  keyId            String
  signature        String
  codeSha256       String
  packageSha256    String
  packageObjectKey String
  downloadCount    Int        @default(0)
  publishedAt      DateTime   @default(now())
  workflow         Workflow   @relation(fields: [workflowId], references: [id])
  submission       Submission @relation(fields: [submissionId], references: [id])
  @@unique([workflowId, version])
  @@index([publishedAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  requestId    String?
  createdAt    DateTime @default(now())
  actor        User?    @relation(fields: [actorId], references: [id])
  @@index([createdAt])
}
