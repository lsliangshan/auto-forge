{
  "name": "example-login-tool",
  "displayName": "示例登录工具",
  "version": "1.0.0",
  "description": "演示 AutoForge 最小插件 Manifest，不包含真实站点凭据。",
  "entry": "dist/index.js",
  "matches": ["https://example.com/*"],
  "permissions": ["page:navigate", "dom:read", "dom:write", "secrets:read"],
  "inputs": {
    "username": {
      "type": "string",
      "required": true,
      "label": "账号"
    },
    "password": {
      "type": "secret",
      "required": true,
      "label": "密码"
    }
  }
}
