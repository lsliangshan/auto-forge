{
  "name": "auto-forge",
  "version": "0.1.0",
  "description": "AutoForge desktop automation tool marketplace.",
  "main": "./out/main/index.js",
  "author": "AutoForge Contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run rebuild:electron --silent && electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "preview": "vite preview --config vite.renderer.config.ts",
    "postinstall": "electron-builder install-app-deps",
    "test:unit": "npm run rebuild:node --silent && vitest run",
    "test:e2e": "npm run build && npm run rebuild:electron --silent && playwright test",
    "typecheck": "npm run typecheck:node && npm run typecheck:renderer",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "vue-tsc --noEmit -p tsconfig.web.json",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild --force --which-module better-sqlite3",
    "verify:template": "node scripts/verify-template.mjs",
    "dist:dir": "npm run build && npm run rebuild:electron --silent && electron-builder --dir --config.npmRebuild=false"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@element-plus/icons-vue": "^2.3.1",
    "better-sqlite3": "^12.11.1",
    "element-plus": "^2.9.14",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "happy-dom": "^17.6.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  }
}
