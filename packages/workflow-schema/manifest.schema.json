{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoForge workflow manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "name",
    "description",
    "author",
    "category",
    "entryPath",
    "codeSha256",
    "permissions",
    "activationExamples",
    "activationNegativeExamples",
    "timeoutMs",
    "inputSchema",
    "outputSchema"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "author": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "cities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "\\S" }
    },
    "entryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "codeSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "permissions": {
      "type": "array",
      "items": { "$ref": "#/definitions/permission" }
    },
    "activationExamples": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "activationNegativeExamples": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
    "inputSchema": {},
    "outputSchema": {},
    "browserContinuation": { "$ref": "#/definitions/browserContinuation" }
  },
  "definitions": {
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "scope"],
      "properties": {
        "capability": {
          "type": "string",
          "enum": [
            "browser.open",
            "browser.fill",
            "browser.click",
            "browser.url",
            "browser.close",
            "network.fetch",
            "filesystem.read",
            "filesystem.write",
            "clipboard.read",
            "clipboard.write",
            "notification.send",
            "artifact.create",
            "file.convert"
          ]
        },
        "scope": { "$ref": "#/definitions/capabilityScope" }
      },
      "allOf": [
        {
          "if": { "properties": { "capability": { "const": "file.convert" } } },
          "then": { "properties": { "scope": { "$ref": "#/definitions/conversionFormatScope" } } }
        },
        {
          "if": { "properties": { "capability": { "type": "string", "pattern": "^browser\\." } } },
          "then": { "properties": { "scope": { "$ref": "#/definitions/browserScope" } } }
        },
        {
          "if": { "properties": { "capability": { "const": "network.fetch" } } },
          "then": { "properties": { "scope": { "$ref": "#/definitions/browserScope" } } }
        },
        {
          "if": { "properties": { "capability": { "type": "string", "pattern": "^filesystem\\." } } },
          "then": { "properties": { "scope": { "$ref": "#/definitions/filesystemScope" } } }
        },
        {
          "if": {
            "properties": {
              "capability": {
                "enum": ["clipboard.read", "clipboard.write", "notification.send", "artifact.create"]
              }
            }
          },
          "then": { "properties": { "scope": { "$ref": "#/definitions/emptyScope" } } }
        }
      ]
    },
    "capabilityScope": {
      "oneOf": [
        { "$ref": "#/definitions/browserScope" },
        { "$ref": "#/definitions/filesystemScope" },
        { "$ref": "#/definitions/conversionFormatScope" },
        { "$ref": "#/definitions/emptyScope" }
      ]
    },
    "browserScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origins"],
      "properties": {
        "origins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "https-url-pattern"
          }
        }
      }
    },
    "filesystemScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "conversionFormatScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "png", "jpeg", "webp", "avif", "tiff", "bmp", "gif", "ico", "icns",
              "pdf", "xlsx", "mp3", "wav", "m4a", "aac", "flac", "ogg", "opus",
              "mp4", "webm", "mov"
            ]
          }
        }
      }
    },
    "emptyScope": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "browserContinuation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth": { "$ref": "#/definitions/browserContinuationAuth" },
        "readableRegions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "format": "browser-locator" }
        },
        "manualActions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/browserManualAction" }
        }
      }
    },
    "browserContinuationAuth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loginUrls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "format": "https-url-pattern" }
        },
        "loggedIn": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "format": "browser-locator" }
        },
        "loggedOut": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "format": "browser-locator" }
        }
      }
    },
    "browserManualAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "reason"],
      "properties": {
        "locator": { "type": "string", "format": "browser-locator" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
